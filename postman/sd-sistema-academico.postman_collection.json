    {
      "name": "4. Falha (pare o registro-service antes)",
      "item": [
        {
          "name": "19 · Turmas com o registro parado → 503 / 504",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/turmas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "turmas"
              ]
            },
            "description": "Antes: `docker stop` no container do registro. Host de pé com o processo parado → 503 (conexão recusada); container sumido da rede do compose → 504 (deadline)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 503 ou 504', () => pm.expect(pm.response.code).to.be.oneOf([503, 504]));"
                ]
              }
            }
          ]
        }
      ]
